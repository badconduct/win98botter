# ── LLM API ──────────────────────────────────────────────────────────────────
# Anthropic example:
BOT_API_URL=https://api.anthropic.com/v1/messages
BOT_API_KEY=sk-ant-...
BOT_MODEL=claude-opus-4-5

# OpenAI example:
# BOT_API_URL=https://api.openai.com/v1/chat/completions
# BOT_API_KEY=sk-...
# BOT_MODEL=gpt-4o

# Local Ollama example:
# BOT_API_URL=http://localhost:11434/v1/chat/completions
# BOT_API_KEY=ollama
# BOT_MODEL=gpt-oss:20b

# ChatGPT subscription via Codex CLI inside the relay container (recommended):
# 1. Build: docker compose build relay
# 2. Sign in once: docker compose run --rm --no-deps relay codex login --device-auth
# 3. Start: docker compose up -d --force-recreate relay
# The login cache is kept in the codex_home Docker volume, never in the image.
# BOT_API_URL=codex://local
# BOT_API_KEY=
# BOT_MODEL=default

# Optional Windows-host bridge alternative:
# Use forward slashes in BOT_CODEX_COMMAND. Use a long random token and keep
# BOT_API_KEY and CODEX_BRIDGE_TOKEN equal.
# BOT_API_URL=http://host.docker.internal:8787/v1
# BOT_API_KEY=replace-with-local-bridge-token
# BOT_MODEL=default
# CODEX_BRIDGE_HOST=0.0.0.0
# CODEX_BRIDGE_PORT=8787
# CODEX_BRIDGE_TOKEN=replace-with-local-bridge-token
# BOT_CODEX_COMMAND=C:/Users/your-user/.vscode/extensions/openai.chatgpt-VERSION-win32-x64/bin/windows-x86_64/codex.exe
# BOT_CODEX_MODEL=default
# BOT_CODEX_TIMEOUT_MS=180000

# ── Win98 TCP listener ───────────────────────────────────────────────────────
# Win98 agent connects outbound to this port
WIN98_LISTEN_PORT=9000
WIN98_LISTEN_HOST=0.0.0.0

# ── HTTP server (VB6 GUI connects here) ──────────────────────────────────────
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ── File staging ──────────────────────────────────────────────────────────────
STAGING_DIR=./staging_data

# ── SQLite (leave blank or omit to use in-memory only) ───────────────────────
DB_PATH=./win98botter.db

# ── Context management ────────────────────────────────────────────────────────
SESSION_CONTEXT_TOKEN_BUDGET=80000

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Watchdog / alerting ───────────────────────────────────────────────────────
# POST alerts here (Slack, Discord, n8n, etc.) — leave empty to disable
ALERT_WEBHOOK_URL=
# Seconds of silence before "disconnected_presumed"
HEARTBEAT_TIMEOUT_SEC=300
# How often the watchdog loop fires
WATCHDOG_INTERVAL_SEC=30
# Optional automated health check schedule
HEALTHCHECKS_PATH=./healthchecks.json

# ── Phase 1 map cache (PostgreSQL) ───────────────────────────────────────────
# Optional feature. Enable persistent per-agent map cache (directory map,
# file-read captures, registry map). Existing chat/session history still uses
# SQLite.
# Set to 1 to enable, or 0 to disable.
PHASE1_PG_ENABLED=1
PHASE1_PG_HOST=postgres
PHASE1_PG_PORT=5432
PHASE1_PG_DATABASE=win98botter
PHASE1_PG_USER=win98botter
PHASE1_PG_PASSWORD=win98botter
PHASE1_PG_SSL=0
# Optional full URL (overrides host/port/db/user/pass when provided):
# PHASE1_PG_URL=postgresql://win98botter:win98botter@postgres:5432/win98botter

# Dockernet: enable PostgreSQL with a provisioned, empty application database.
# Configure shared AI with matching BOT_API_URL and BOT_MANAGED_API_URL.
# BOT_MANAGED_API_URL=https://ai.example.invalid/v1
# BOT_API_KEY_FILE=/run/secrets/ai-client-token
# BOT_AI_PROFILE=win98botter
# Keep SQLite for existing history/state; no data import is required.
# These settings work with either a shared or dedicated PostgreSQL container.
# PHASE1_PG_SCHEMA_MODE=external
# PHASE1_PG_HOST=postgresql
# PHASE1_PG_USER=win98botter_app
# PHASE1_PG_PASSWORD_FILE=/run/secrets/postgresql/runtime-password
# PHASE1_PG_SSL=1
# PHASE1_PG_CA_FILE=/run/secrets/postgresql/ca.crt
# Unset PHASE1_PG_URL; it must not override file credentials or TLS policy.
# Apply db/migrations/001-phase1-map.sql as the owner via a migrator first.
